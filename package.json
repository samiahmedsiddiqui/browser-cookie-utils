{
	"name": "browser-cookie-utils",
	"version": "2.0.1",
	"description": "Lightweight, dependency-free JavaScript helpers for getting, setting, and deleting browser cookies with modern browser support.",
	"type": "module",
	"main": "dist/browser-cookie-utils.min.cjs",
	"module": "dist/browser-cookie-utils.min.js",
	"types": "dist/browser-cookie-utils.d.ts",
	"unpkg": "dist/browser-cookie-utils.umd.js",
	"jsdelivr": "dist/browser-cookie-utils.umd.js",
	"exports": {
		".": {
			"import": {
				"types": "./dist/browser-cookie-utils.d.ts",
				"default": "./dist/browser-cookie-utils.min.js"
			},
			"require": {
				"types": "./dist/browser-cookie-utils.d.cts",
				"default": "./dist/browser-cookie-utils.min.cjs"
			},
			"default": "./dist/browser-cookie-utils.min.js"
		},
		"./umd": "./dist/browser-cookie-utils.umd.js",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*.{js,ts}\" \"test/**/*.js\" build.js",
		"format:check": "prettier --check \"src/**/*.{js,ts}\" \"test/**/*.js\" build.js",
		"build": "node build.js",
		"test": "npm run build && node --test test/browser-cookie-utils.test.js",
		"prepublishOnly": "npm run lint && npm test"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/samiahmedsiddiqui/browser-cookie-utils.git"
	},
	"keywords": [
		"cookie",
		"cookies",
		"browser",
		"utils",
		"samesite",
		"secure",
		"frontend",
		"web"
	],
	"author": "Sami Ahmed Siddiqui <samiahmedsiddiqui91@gmail.com>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/samiahmedsiddiqui/browser-cookie-utils/issues"
	},
	"homepage": "https://github.com/samiahmedsiddiqui/browser-cookie-utils#readme",
	"devDependencies": {
		"eslint": "10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.6",
		"prettier": "3.9.10",
		"terser": "5.51.2"
	}
}
